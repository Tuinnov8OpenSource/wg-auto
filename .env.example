# Django Settings
DEBUG=0
DJANGO_SECRET_KEY=generate_a_secure_random_key_for_production
ALLOWED_HOSTS=localhost,127.0.0.1,vpn.example.com
CSRF_TRUSTED_ORIGINS=https://vpn.example.com

# Database
DATABASE_NAME=wireguard_db
DATABASE_USER=wireguard_user
DATABASE_PASSWORD=your_secure_db_password
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379

# WireGuard
ENCRYPTION_KEY=generate_with_fernet_for_production
WIREGUARD_INTERFACE=wg0
WIREGUARD_ENDPOINT=vpn.example.com:51820

# Default Admin (created automatically on first boot)
DJANGO_SUPERUSER_USERNAME=wgauto
DJANGO_SUPERUSER_PASSWORD=wgauto123
DJANGO_SUPERUSER_EMAIL=admin@wgauto.local
